# Copy to .env and fill in. Never commit .env.

# Required. Generate with: docker compose run --rm app hash-password
# (or: dotnet run --project src/JaCrm.Api -- hash-password)
JACRM_PASSWORD_HASH=

# Local only: port on this machine (http://localhost:8080).
JACRM_PORT=8080

# Keep "false" for plain-HTTP local use. compose.vps.yaml forces "true" behind HTTPS.
JACRM_SECURE_COOKIE=false

# Time zone for "today" (automatic submission date, deadlines, staleness).
JACRM_TIME_ZONE=Europe/Belgrade

# VPS only: the domain Caddy requests a certificate for, e.g. jobs.example.com
JACRM_DOMAIN=
